{
  "_说明": "构件识别规则：每条规则含 name(构件名)、block_re(块名/INSERT 正则)、layer_re(图层名正则)。匹配时不区分大小写。可用 --rules 指向自定义 JSON 覆盖。",
  "rules": [
    {
      "name": "门",
      "block_re": "^(M_?DOOR|DOOR|门|MC|MH|TM|DOOR_)",
      "layer_re": "(DOOR|门|MCDOOR)"
    },
    {
      "name": "窗",
      "block_re": "^(W_?WIN|WIN|WC|WINDOW|窗|CHUANG)",
      "layer_re": "(WINDOW|窗|WCWIN)"
    },
    {
      "name": "梁",
      "block_re": "(BEAM|梁|LIANG|KL|WKL|XL)",
      "layer_re": "(BEAM|梁|S_BEAM|STRB)"
    },
    {
      "name": "柱",
      "block_re": "(COLUMN|COL|柱|ZHU|KZ)",
      "layer_re": "(COLUMN|柱|S_COL|STRC)"
    },
    {
      "name": "钢筋",
      "block_re": "(REBAR|BAR|钢筋|REINFORCE|STEEL)",
      "layer_re": "(REBAR|钢筋|STEEL|REIN)"
    },
    {
      "name": "楼梯",
      "block_re": "(STAIR|楼梯|LT|LOUTI)",
      "layer_re": "(STAIR|楼梯)"
    },
    {
      "name": "电梯",
      "block_re": "(LIFT|ELEVATOR|电梯|DT)",
      "layer_re": "(LIFT|ELEVATOR|电梯)"
    },
    {
      "name": "墙",
      "block_re": "(WALL|墙|QIANG)",
      "layer_re": "(WALL|墙|S_WALL)"
    },
    {
      "name": "板",
      "block_re": "(SLAB|板|BAN|B$)",
      "layer_re": "(SLAB|板|S_SLAB)"
    },
    {
      "name": "基础",
      "block_re": "(FOUND|基础|JC|JICHU)",
      "layer_re": "(FOUND|基础|S_FD)"
    },
    {
      "name": "管道",
      "block_re": "(PIPE|管|GUAN|GD)",
      "layer_re": "(PIPE|管|冷凝|排水|给水|水管)"
    },
    {
      "name": "设备",
      "block_re": "(EQUIP|设备|FAN|AHU|KT|SB)",
      "layer_re": "(EQUIP|设备|暖通|HVAC|电气)"
    },
    {
      "name": "家具",
      "block_re": "(FURNITURE|FURN|家具|SOFA|BED|TABLE|DESK|CHAIR|JIAJU)",
      "layer_re": "(FURNITURE|家具|FF)"
    },
    {
      "name": "轴线/轴号",
      "block_re": "^(AXIS|CIRCLE_AXIS|轴)",
      "layer_re": "(AXIS|轴|C-AXIS|ZH)"
    },
    {
      "name": "标高",
      "block_re": "^(ELEV|LEVEL|标高|BG)",
      "layer_re": "(ELEV|标高|LEVEL|高程|断面高程)"
    },
    {
      "name": "索引/详图",
      "block_re": "^(DETAIL|INDEX|SECTION|索引|详图)",
      "layer_re": "(DETAIL|索引|详图|SECTION)"
    },
    {
      "name": "标注",
      "block_re": "^(DIM|DIMENSION|标注)",
      "layer_re": "(DIM|标注|注释)"
    },
    {
      "name": "图签/图框",
      "block_re": "(TITLE|FIGURE|图签|图框|TK)",
