    },
    {
      "name": "渠道",
      "block_re": "(CANAL|渠道|QUDAO)",
      "layer_re": "(CANAL|渠道|渠)"
    },
    {
      "name": "排水沟",
      "block_re": "(DITCH|排水|排沟|PAIGOU)",
      "layer_re": "(DITCH|排沟|排水沟|排水)"
